{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arquivoX",
  "version": "0.1.0",
  "identifier": "com.arquivox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "arquivoX",
        "width": 480,
        "height": 640,
        "dragDropEnabled": true
      },
      {
        "label": "wheel",
        "url": "index.html?view=wheel",
        "width": 440,
        "height": 440,
        "x": -10000,
        "y": -10000,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
